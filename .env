# SOVR Financial OS — Production environment template
# Copy to .env and adjust for your deployment.

# --- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
SOVR_LOG_LEVEL=info

# --- JWT (REQUIRED in production) -------------------------------------------
# RS256 asymmetric signing. Generate with:
#   bash scripts/generate-jwt-keys.sh
# Must be at least 2048-bit RSA.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# --- Capability engine ------------------------------------------------------
# MUST be false in production. Setting true violates INV-003/004.
SOVR_DEV_AUTO_GRANT=false

# --- Kafka publisher (optional) --------------------------------------------
# When enabled, every event is published to topic sovr.{domain}.{aggregate}.{event_name}
SOVR_KAFKA_ENABLED=false
SOVR_KAFKA_BROKERS=broker1:9092,broker2:9092
SOVR_KAFKA_CLIENT_ID=sovr-runtime

# --- Redis stream publisher (optional) -------------------------------------
# When enabled, every event is XADDed to sovr:stream:{domain}:{aggregate}
SOVR_REDIS_ENABLED=false
SOVR_REDIS_URL=redis://localhost:6379
SOVR_REDIS_STREAM_MAXLEN=100000

# --- PostgreSQL event store (optional) ---------------------------------------
# Set to use PostgreSQL as the event store instead of JSON file.
# Leave unset for development JSON mode.
# DATABASE_URL=postgres://sovr:sovr_dev_secret@localhost:5432/sovr_events

# --- ACH boundary adapter (mock bank) --------------------------------------
SOVR_ACH_ROUTING_NUMBER=021000021
SOVR_ACH_BANK_NAME=SOVR Sandbox Bank
SOVR_ACH_LATENCY_MS=50

# ══════════════════════════════════════════════════════
# SOVR Protocol — Rail Driver Environment Variables
# Directive XXI
# ══════════════════════════════════════════════════════

# ── TigerBeetle Financial Database ────────────────────
TIGERBEETLE_CLUSTER_ID=0
TIGERBEETLE_ADDRESSES=127.0.0.1:3000,127.0.0.1:3001,127.0.0.1:3002
# Multi-node production:
# TIGERBEETLE_ADDRESSES=tb-1:3000,tb-2:3000,tb-3:3000
TIGERBEETLE_CONCURRENCY=32

# ── ACH ───────────────────────────────────────────────
ACH_PROVIDER=dwolla
ACH_API_KEY=
ACH_API_SECRET=
ACH_COMPANY_ID=
ACH_COMPANY_NAME=SOVR
ACH_ENTRY_DESC=SOVR
ACH_ODFI_ROUTING=

# ── FedNow ────────────────────────────────────────────
FEDNOW_PARTICIPANT_ID=
FEDNOW_BANK_URL=
FEDNOW_API_KEY=

# ── Fedwire ───────────────────────────────────────────
WIRE_BANK_URL=
WIRE_API_KEY=
WIRE_SENDER_ROUTING=
WIRE_SENDER_ACCOUNT=

# ── RTP ───────────────────────────────────────────────
RTP_BANK_URL=
RTP_API_KEY=
RTP_PARTICIPANT_ID=

# ── Card Networks ─────────────────────────────────────
CARD_PROVIDER=marqeta
CARD_API_KEY=
CARD_API_SECRET=

# ── EVM Blockchain ────────────────────────────────────
EVM_RPC_URL=
EVM_PRIVATE_KEY=
EVM_CHAIN_ID=1

# ── Stablecoin (USDC via Circle) ──────────────────────
CIRCLE_API_KEY=
CIRCLE_WALLET_ID=

# ── SWIFT ─────────────────────────────────────────────
SWIFT_BANK_URL=
SWIFT_API_KEY=
SWIFT_BIC=

# ── SEPA ──────────────────────────────────────────────
SEPA_BANK_URL=
SEPA_API_KEY=
SEPA_SOURCE_IBAN=

# ── Price Oracle ──────────────────────────────────────
ORACLE_PROVIDER=internal
ORACLE_API_KEY=
